from typing import Any

from . import nn  # noqa: F401
from .nn import Module  # noqa: F401

class Tensor:
    shape: tuple[int, ...]
    def backward(self) -> None: ...
    def item(self) -> float: ...
    def numel(self) -> int: ...
    def unsqueeze(self, dim: int) -> Tensor: ...
    def split(self, split_size: int, dim: int = ...) -> tuple[Tensor, ...]: ...
    def reshape(self, *shape: int) -> Tensor: ...
    def transpose(self, dim0: int, dim1: int) -> Tensor: ...
    def masked_fill(self, mask: Tensor, value: float) -> Tensor: ...
    def clamp_min(self, min: float) -> Tensor: ...
    def cpu(self) -> Tensor: ...
    def numpy(self) -> Any: ...
    def __getitem__(self, key: Any) -> Tensor: ...
    def __mul__(self, other: Any) -> Tensor: ...
    def __rmul__(self, other: Any) -> Tensor: ...
    def __neg__(self) -> Tensor: ...
    def __sub__(self, other: Any) -> Tensor: ...
    def __matmul__(self, other: Any) -> Tensor: ...
    def __pow__(self, other: Any) -> Tensor: ...
    def __eq__(self, other: Any) -> Tensor: ...  # type: ignore[override]
    def __add__(self, other: Any) -> Tensor: ...
    def __truediv__(self, other: Any) -> Tensor: ...
    def argmax(self, dim: int | None = ...) -> Tensor: ...
    def clamp(self, min: Any = ..., max: Any = ...) -> Tensor: ...
    def float(self) -> Tensor: ...
    def gather(self, dim: int, index: Tensor) -> Tensor: ...
    def squeeze(self, dim: int = ...) -> Tensor: ...
    def unsqueeze_at(self, dim: int) -> Tensor: ...
    def mean(self) -> Tensor: ...

class _Generator:
    def manual_seed(self, seed: int) -> _Generator: ...

class optim:
    @staticmethod
    def AdamW(*args: Any, **kwargs: Any) -> Any: ...
    @staticmethod
    def Adam(*args: Any, **kwargs: Any) -> Any: ...
    @staticmethod
    def SGD(params: Any, lr: float = ..., **kwargs: Any) -> Any: ...

class cuda:
    @staticmethod
    def is_available() -> bool: ...
    @staticmethod
    def manual_seed_all(seed: int) -> None: ...

def manual_seed(seed: int) -> None: ...
def set_num_threads(n: int) -> None: ...

float32: Any
cfloat: Any

def tensor(data: Any, dtype: Any = ...) -> Tensor: ...
def as_tensor(data: Any, dtype: Any = ...) -> Tensor: ...
def triu(input: Tensor, diagonal: int = ...) -> Tensor: ...
def ones(*size: int, dtype: Any = ...) -> Tensor: ...
def softmax(input: Tensor, dim: int = ...) -> Tensor: ...
def randint(high: int, size: tuple[int, ...], generator: _Generator = ...) -> Tensor: ...
def from_numpy(array: Any) -> Tensor: ...
def no_grad() -> Any: ...
def sum(input: Tensor, dim: int | None = ...) -> Tensor: ...
def log(input: Tensor) -> Tensor: ...
def stack(tensors: list[Tensor], dim: int = ...) -> Tensor: ...
def mean(input: Tensor, dim: int | None = ...) -> Tensor: ...
def maximum(input: Tensor, other: Tensor) -> Tensor: ...
def randn(*size: int | tuple[int, ...], dtype: Any = ..., **kwargs: Any) -> Tensor: ...
def cumsum(input: Tensor, dim: int = ...) -> Tensor: ...
def cat(tensors: tuple[Tensor, ...] | list[Tensor], dim: int = ...) -> Tensor: ...
def full_like(input: Tensor, value: Any) -> Tensor: ...
def ones_like(input: Tensor) -> Tensor: ...
def clamp(input: Tensor, min: Any = ..., max: Any = ...) -> Tensor: ...
def searchsorted(sorted_sequence: Tensor, input: Tensor) -> Tensor: ...
