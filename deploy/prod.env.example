# Production environment reference. Compose reads deploy/prod.env, not this
# file. The root .env.example is intentionally smaller: it does not select
# the production profile. Do not put secret values in this file.

# DIPCATCHER_PROFILE
# default: production
# why: selects the production boot rules. Unset, outside this file, leaves
# the rate limit off and does not require a read-only research mount.
DIPCATCHER_PROFILE=production

# DIPCATCHER_RATE_LIMIT_RPS
# default: 50
# why: caps both APIs. /health is exempt. Under the production profile an
# unset value uses the same 50 inside the process, so the limit cannot stay
# off. 0 and any invalid value still refuse to boot.
DIPCATCHER_RATE_LIMIT_RPS=50

# DIPCATCHER_REQUIRE_DATA_WRITE
# default: 1
# why: the lab command must be able to write its data directory. The research
# command under the production profile ignores this and requires read-only.
DIPCATCHER_REQUIRE_DATA_WRITE=1

# DIPCATCHER_WRITE_OWNER
# default: lab-a 1, lab-b 0, research-a 0, research-b 0
# why: one writer for the lab ledger and kill file. Compose sets it per
# replica. It is not a single line in deploy/prod.env. Unset under the
# production profile refuses ledger and kill-file writes.

# DIPCATCHER_BIND_HOST
# default: 0.0.0.0
# why: the lab replica listens on the compose network. The host publishes
# only the proxy. Off-loopback requires QUANT_API_KEY.
DIPCATCHER_BIND_HOST=0.0.0.0

# DIPCATCHER_BIND_PORT
# default: 8000
# why: lab listen port inside the network. It is not published on the host.
DIPCATCHER_BIND_PORT=8000

# PORT
# default: 8000 for lab, 8010 for research
# why: fallback when the named bind port is unset.
PORT=8000

# QUANT_API_KEY
# default: none (required)
# why: lab API, lab metrics, the proxy's lab health check, and Prometheus.
# Export it in the shell. One token: no spaces, quotes, braces, or hash.
# Do not write the value in this file.

# RESEARCH_API_KEY
# default: none (required)
# why: research API, research metrics, the proxy's research health check,
# and Prometheus. Same token rule. Export it in the shell. prod-secrets
# copies it into a file. The container does not receive the plain value.

# QUANT_API_KEY_FILE
# default: /run/secrets/quant_api_key inside the container
# why: under the production profile the lab API, the proxy, and Prometheus
# read the lab key from this file. A plain QUANT_API_KEY in the container
# is refused. The host path is DIPCATCHER_QUANT_API_KEY_FILE.

# RESEARCH_API_KEY_FILE
# default: /run/secrets/research_api_key inside the container
# why: same rule for the research key. The host path is
# DIPCATCHER_RESEARCH_API_KEY_FILE.

# DIPCATCHER_QUANT_API_KEY_FILE
# default: /tmp/dipcatcher-ops7-secrets/quant_api_key
# why: host file mounted as the quant_api_key docker secret. Mode 600.
# Not committed. The makefile exports the path.

# DIPCATCHER_RESEARCH_API_KEY_FILE
# default: /tmp/dipcatcher-ops7-secrets/research_api_key
# why: host file mounted as the research_api_key docker secret. Mode 600.

# DIPCATCHER_ALERT_WEBHOOK_SECRET
# default: none
# why: optional HMAC secret for an alert webhook. Under the production
# profile a plain value is refused. Export it in the shell only when you
# want prod-secrets to rewrite the file. Do not write the value here.

# DIPCATCHER_ALERT_WEBHOOK_SECRET_FILE
# default: /run/secrets/alert_webhook_secret inside the container, and
# /tmp/dipcatcher-ops7-secrets/alert_webhook_secret on the host
# why: docker secret for the webhook HMAC. When the shell value is unset,
# prod-secrets keeps an existing token file or writes a new random token.
# The value is not printed.

# DIPCATCHER_ALERT_WEBHOOK_URL
# default: unset
# why: optional http(s) alert webhook. No userinfo. When it is set, the
# webhook secret file is required. The prod compose file leaves it unset.

# RESEARCH_API_HOST
# default: 0.0.0.0
# why: the research replica listens on the compose network.
RESEARCH_API_HOST=0.0.0.0

# RESEARCH_API_PORT
# default: 8010
# why: research listen port inside the network. It is not published.
RESEARCH_API_PORT=8010

# RESEARCH_API_DATA_ROOT
# default: /app/data
# why: research readiness checks this directory. The mount is read-only.
RESEARCH_API_DATA_ROOT=/app/data

# DIPCATCHER_OBSERVE
# default: 1
# why: turns on metrics, JSON audit events, and the alert loop.
DIPCATCHER_OBSERVE=1

# DIPCATCHER_METRICS_HOST
# default: 0.0.0.0
# why: Prometheus scrapes inside the compose network. Do not publish 9464.
DIPCATCHER_METRICS_HOST=0.0.0.0

# DIPCATCHER_METRICS_PORT
# default: 9464
# why: metrics port. The prod compose file does not map it to the host.
DIPCATCHER_METRICS_PORT=9464

# DIPCATCHER_METRICS_KEY_ENV
# default: QUANT_API_KEY on lab, RESEARCH_API_KEY on research
# why: names the variable that authenticates /metrics.
DIPCATCHER_METRICS_KEY_ENV=QUANT_API_KEY

# DIPCATCHER_METRICS_LOOPBACK_SCRAPE
# default: unset (off)
# why: the prod compose file does not allow an unauthenticated scrape.

# DIPCATCHER_LOG_LEVEL
# default: INFO
# why: service logs. DEBUG, INFO, WARNING, ERROR, or CRITICAL.
DIPCATCHER_LOG_LEVEL=INFO

# DIPCATCHER_SHUTDOWN_GRACE_S
# default: 20
# why: seconds to finish requests after SIGTERM. Compose allows 30.
DIPCATCHER_SHUTDOWN_GRACE_S=20

# DIPCATCHER_DATA_ROOT
# default: /app/data
# why: paper ledger, kill file, and the write lock live here.
DIPCATCHER_DATA_ROOT=/app/data

# DIPCATCHER_KILL_SWITCH_PATH
# default: /app/data/kill_switch
# why: one kill file for readiness, paper, and the harness drain. Only lab-a
# can write it. A missing file means ENABLED.
DIPCATCHER_KILL_SWITCH_PATH=/app/data/kill_switch

# DIPCATCHER_CONFIG
# default: configs/research.yaml
# why: lab config path. A path outside configs/ is rejected.

# DIPCATCHER_SLO_PATH
# default: the shipped deploy/observability/slo.yml when observe is on
# why: alert thresholds. A symlink or invalid file refuses startup.

# DIPCATCHER_ALERT_INTERVAL_S
# default: 60
# why: alert loop period.

# DIPCATCHER_OTEL_ENDPOINT
# default: unset
# why: optional http or https collector. The prod compose file leaves it off.

# DIPCATCHER_HALT_CANCELS_OPEN_ORDERS
# default: unset (off)
# why: HALT_NEW_ORDERS cancels resting paper orders only when this is on.

# DIPCATCHER_KILL_DRAIN_DEBOUNCE_S
# default: 1
# why: how long the kill file must stay ENABLED before the harness drain clears.

# DIPCATCHER_LAB_DATA
# default: /tmp/dipcatcher-ops7-data/lab
# why: host directory for the lab ledger and kill file. Owned by uid 10001.
# The makefile exports it. Compose refuses to start when it is missing.

# DIPCATCHER_RESEARCH_DATA
# default: /tmp/dipcatcher-ops7-data/research
# why: host directory mounted read-only at /app/data on both research replicas.

# DIPCATCHER_TLS_DIR
# default: /tmp/dipcatcher-ops7-tls
# why: dev.crt and dev.key. The key is mode 600. Neither file is committed.

# LAB_TLS_PORT
# default: 8443
# why: loopback TLS listener for the lab API.

# RESEARCH_TLS_PORT
# default: 8444
# why: loopback TLS listener for the research API.

# PROMETHEUS_PUBLISH_PORT
# default: 9090
# why: loopback Prometheus. Not 9464.

# GRAFANA_PUBLISH_PORT
# default: 3000
# why: loopback Grafana. Anonymous viewer, no admin password in compose.

# SUDO
# default: sudo
# why: prefixes docker and chown. Set it empty on the make command line when
# the user can run docker directly.

# PROJECT
# default: dipcatcher-ops7
# why: compose project name and the container name prefix.

# LAB_A, LAB_B, RESEARCH_A, RESEARCH_B
# default: $(PROJECT)-<service>-1
# why: the containers prod-restart drains, one at a time.

# GF_AUTH_ANONYMOUS_ENABLED
# default: true
# why: local Grafana viewer. The compose file does not set an admin password.

# GF_AUTH_ANONYMOUS_ORG_ROLE
# default: Viewer
# why: anonymous sessions cannot edit dashboards.

# LOG_DIR
# default: /tmp/dipcatcher-ops7-logs
# why: host directory for app, proxy, and audit retention. Compose mounts
# it at /logs. Allowed prefixes are /tmp/dipcatcher-*, /var/log/dipcatcher*,
# and /var/lib/dipcatcher*. The makefile exports it as DIPCATCHER_LOG_DIR.

# DIPCATCHER_LOG_MAX_SIZE
# default: 10m
# why: Docker json-file max-size for app, proxy, and the other compose
# services. json-file has no age cap.

# DIPCATCHER_LOG_MAX_FILE
# default: 5
# why: Docker json-file max-file. The live *-json.log is not renamed.

# DIPCATCHER_LOG_MAX_BYTES
# default: 10485760
# why: size cap for files under LOG_DIR. A rotated copy is path.1.

# DIPCATCHER_LOG_MAX_AGE_S
# default: 604800
# why: age cap, in seconds, for rotated copies. Active files stay.

# DIPCATCHER_LOG_MAX_FILES
# default: 5
# why: how many numbered copies to keep. Older indexes are deleted.

# DIPCATCHER_APP_LOG_MAX_BYTES
# DIPCATCHER_APP_LOG_MAX_AGE_S
# DIPCATCHER_APP_LOG_MAX_FILES
# default: the shared DIPCATCHER_LOG_* values
# why: optional app-stream overrides. PROXY and AUDIT use the same suffix.

# DIPCATCHER_AUDIT_LOG_PATH
# default: unset, except the production compose file sets one file per replica
# why: absolute path for one already-redacted JSON line per service event.
# A relative path or a symlink is ignored. Not an ENV_CONTRACT name.

# DIPCATCHER_AUDIT_LOG_MAX_BYTES
# default: 10485760
# why: in-process audit size cap. The retain timer applies the age cap.

# DIPCATCHER_AUDIT_LOG_MAX_FILES
# default: 5
# why: in-process numbered audit copies. entries.jsonl is not this file.

# BACKUP_ROOT
# default: /tmp/dipcatcher-ops7-backups
# why: parent of UTC stamp directories. It is not BACKUP_DIR. prod-backup
# still writes one archive at BACKUP_DIR.

# DIPCATCHER_BACKUP_COPY
# default: none
# why: none verifies the stamp, rsync copies it, s3 copies it with the aws
# CLI. A failed hash check does not copy.

# DIPCATCHER_BACKUP_RSYNC_TARGET
# default: unset
# why: local absolute path or user@host:/absolute. No spaces, no leading
# dash, no password in the user.

# DIPCATCHER_BACKUP_S3_URI
# default: unset
# why: s3://bucket/prefix. Do not put AWS keys in this file. Use an
# instance role.
