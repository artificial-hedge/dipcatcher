# Production profile for deploy/compose.prod.yml. No secrets in this file.
# Export QUANT_API_KEY and RESEARCH_API_KEY in the shell before compose up.
# DIPCATCHER_PROFILE is intentionally absent from .env.example: unset keeps
# the rate limit off and leaves the research image's read-only default alone.
# An unset DIPCATCHER_RATE_LIMIT_RPS under this profile uses 50 in the process.
# Under this profile the research command refuses a writable data directory.
# Compose mounts that directory read-only. Lab replicas stay writable.
# DIPCATCHER_WRITE_OWNER is also absent. Compose sets it per replica.
DIPCATCHER_PROFILE=production
DIPCATCHER_RATE_LIMIT_RPS=50
DIPCATCHER_REQUIRE_DATA_WRITE=1
