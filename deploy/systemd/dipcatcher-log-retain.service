[Unit]
Description=Rotate dipcatcher app, proxy, and audit logs
After=docker.service

[Service]
Type=oneshot
User=root
Environment=SUDO=
ExecStart=/opt/dipcatcher/.venv/bin/python /opt/dipcatcher/scripts/log_retain.py --root /var/log/dipcatcher --docker-project dipcatcher-ops7
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
