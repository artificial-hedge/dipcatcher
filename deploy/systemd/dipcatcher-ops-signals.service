[Unit]
Description=Republish dipcatcher reconcile, backup, and canary gauges
After=docker.service

[Service]
Type=oneshot
User=root
Environment=DIPCATCHER_TEXTFILE_DIR=/var/lib/dipcatcher/textfile
WorkingDirectory=/opt/dipcatcher
ExecStart=/opt/dipcatcher/.venv/bin/python /opt/dipcatcher/scripts/ops_signals.py refresh
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
