{
  "annotations": {"list": []},
  "description": "Operator signals for the lab process: SLO latency, error rate, freshness, readiness, SIGTERM drain, and the kill-switch code. These panels are operational telemetry. They are not research scores and they are not a live P&L claim.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "dipcatcher_ready", "legendFormat": "ready", "refId": "A"}],
      "title": "Readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "dipcatcher_draining", "legendFormat": "draining", "refId": "A"}],
      "title": "SIGTERM drain",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "dipcatcher_kill_switch_blocking",
          "legendFormat": "blocking",
          "refId": "A"
        }
      ],
      "title": "Kill switch blocking",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [
        {
          "expr": "dipcatcher_kill_switch_info",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Kill switch code",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, stage) (rate(dipcatcher_stage_latency_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "title": "Stage latency p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "targets": [
        {
          "expr": "dipcatcher_data_freshness_seconds",
          "legendFormat": "freshness",
          "refId": "A"
        }
      ],
      "title": "Data freshness",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "targets": [
        {
          "expr": "sum by (stage) (rate(dipcatcher_errors_total[5m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Error ratio against the 0.01 SLO. otel_export is excluded, matching the in-process evaluator.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(dipcatcher_errors_total{stage!=\"otel_export\"}[5m])) / sum(rate(dipcatcher_stage_latency_seconds_count[5m]))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "title": "Error ratio",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["dipcatcher", "ops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "utc",
  "title": "Dipcatcher operator signals",
  "uid": "dipcatcher-ops",
  "version": 1
}
