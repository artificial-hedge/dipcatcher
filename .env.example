# dipcatcher / fx-1 environment contract — copy to .env and fill in locally.
# NEVER commit .env or any real value. Every entry below is a NAME with an
# empty/placeholder slot only; the tracked tree must contain no live values
# (enforced by the `secret-scan` pre-commit hook, `scripts/secret_scan.py`,
# and gitleaks). Diagnostics (`fx1 doctor`, `dipcatcher doctor`) report
# presence flags, never values.
#
# Legend:  [required] ... for the named workflow   [optional] ... has a safe default
#          [conditional] ... required only in the named situation
# Research commands do not place orders. `dipcatcher live` without a gateway
# config is the operator desk (docs/LIVE_DESK.md): shadow by default, no
# broker credential, and drop-folder tickets only when DIP_LIVE_ARM=1.
# A gateway file can submit to Alpaca paper (docs/LIVE_TRADING.md). The
# Alpaca live host is refused by the honesty contract. Leave the keys unset
# unless you intend to arm the paper venue.

# ── Broker gateway, Alpaca paper only (dipcatcher live --config) ────────
# [conditional] Used only when the gateway venue is alpaca-paper. Never
# commit a value. The live host api.alpaca.markets is refused even if these
# are set. APCA_* names are accepted aliases.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# ── Data roots, run tracking, caches ────────────────────────────────────
QUANT_DATA_ROOT=data
# [optional] Bound `dipcatcher research` to the required-family scorecard.
# examples/01_receipt_round_trip.py sets this itself. Unset runs the full
# wired catalog.
# DIPCATCHER_RESEARCH_REQUIRED_ONLY=1
# [optional] Checkout root when the process cwd is not the repo
# (lab doctor, harness, /superpower). Either name is accepted.
# DIPCATCHER_ROOT=
# QUANT_REPO_ROOT=
# [optional] MLflow run-tracking location (read by the mlflow client library).
MLFLOW_TRACKING_URI=./mlruns
# [optional] Silence the MLflow tracing-skill hint. The lab sets this to 1
# at logging import (`quant_fund.utils.logging`).
# MLFLOW_DISABLE_AGENT_HINT=1
# [optional] Cache dir for mito0o852/OHLCV-1m monthly Parquet files.
# HF_OHLCV_1M_CACHE=data/hf_ohlcv_1m
# [optional] Cache dir for the DoltHub as-traded stocks adapter.
# DOLTHUB_STOCKS_CACHE=data/dolthub_stocks

# ── Harness / research API auth ─────────────────────────────────────────
# [conditional] Required for non-localhost harness API access (send as
# X-API-Key). Prefer binding 127.0.0.1 and leaving this unset.
# QUANT_API_KEY=
# [optional] Licensed vendor adapter credential; unset means fail-closed
# (reserved surface — no adapter reads it in the open tree).
# QUANT_VENDOR_API_KEY=
# [conditional] When set, every research-API route requires X-API-Key;
# without it the server binds loopback only.
# RESEARCH_API_KEY=

# ── Signing keys (evidence integrity — never commit, never log) ─────────
# [conditional] Ed25519 gate key: '<priv_hex>:<pub_hex>', a key-file path,
# or bare priv hex. Needed by `dipcatcher sign-pins` / `attest` /
# `checkpoint`; absent that, pins cannot be signed (fail closed).
# GATE_SIGNING_KEY=
# [conditional] Incoming Ed25519 key for `dipcatcher rotate-key`
# (outgoing key comes from GATE_SIGNING_KEY). One-shot per rotation.
# GATE_SIGNING_KEY_NEW=
# [conditional] Quorum signing pairs (comma-separated) for
# `dipcatcher quorum-sign` when no --key-file is given.
# GATE_QUORUM_KEYS=
# [conditional] Proof-core signing key (hex or raw bytes) for
# `quant_fund.proof.sign` artifact signing/verification.
# PROOFCORE_SIGNING_KEY=
# [conditional] ECDSA P-256 witness key (PEM text or file path) for
# `dipcatcher witness-checkpoint` / `attest --witness` (Rekor anchoring).
# WITNESS_SIGNING_KEY=
# [optional] Enables checkpoint-signature enforcement when serving a
# local fx-1 checkout (fx1.serve / fx1 doctor report presence only).
# FX1_SIGNING_KEY=
# [optional] Keyless Sigstore signing of audit-ledger tree heads.
# No token means no bundle is signed.
# DIPCATCHER_SIGSTORE_ID_TOKEN=
# [optional] Sigstore instance for the above (default `production`).
# DIPCATCHER_SIGSTORE_INSTANCE=production

# ── fx-1 public web research (superpower) ───────────────────────────────
# [optional] Opt in to DuckDuckGo-backed web research in /superpower runs.
# Unset or 0 keeps web_research skipped (fail closed on outbound search).
# FX1_WEB_RESEARCH=1
# [optional] Concierge run-budget caps (positive numbers). Unset uses defaults.
# FX1_BUDGET_WALL_S=
# FX1_BUDGET_HARNESS_STEPS=
# FX1_BUDGET_MODEL_CALLS=
# FX1_BUDGET_RETRIES=
# FX1_BUDGET_WEB_SOURCES=
# FX1_BUDGET_PROMPT_TOKENS=
# [optional] Restrict `dipcatcher research` to the required family battery.
# DIPCATCHER_RESEARCH_REQUIRED_ONLY=1

# ── fx-1 hosted eval / model lane ───────────────────────────────────────
# [conditional] Required for `fx1 eval --backend hosted_k3` / `make fx1-eval`
# (Moonshot hosted API). Not needed for offline/local backends.
# MOONSHOT_API_KEY=
# [optional] Override of the hosted backend endpoint (default is the
# public Moonshot chat-completions URL in fx1.serve.backends).
# FX1_BASE_URL=
# [optional] Per-model chat credentials. Stored profiles win. A per-model
# key with no per-model URL uses FX1_BASE_URL, else the Moonshot constant.
# A per-model URL without a per-model key does not replace the shared URL.
# DIPCATCHER_FX1_API_KEY=
# DIPCATCHER_FX1_BASE_URL=
# DIPCATCHER_FX1_LITE_API_KEY=
# DIPCATCHER_FX1_LITE_BASE_URL=
# [optional] Local concierge telemetry level: off, error, info (default),
# or debug. Unknown values fall back to info. The log stays on disk.
# DIPCATCHER_LOG=info
# [optional] Chat session directory. Else $FX1_CONFIG_DIR/sessions,
# else ~/.fx1/sessions.
# FX1_SESSION_DIR=
# [optional] Character ceiling for the conversation sent to a model in chat
# (default 400000, minimum 4000). Oldest whole turns are dropped from the
# request first; the saved session keeps everything.
# FX1_CONTEXT_MAX_CHARS=
# [optional] Root for fx1 interactive profiles/flash state
# (default ~/.fx1). Profiles store per-endpoint credentials here.
# FX1_CONFIG_DIR=
# [optional] Root for fx1 SDK eval/finetune stores (binds the SDK's
# state to a directory; default is the SDK's own state dir).
# FX1_SDK_STATE_DIR=
# [optional] Local checkpoint directory for `serve`/`local_engine`.
# FX1_CHECKPOINT_DIR=
# [optional] Work directory for the fine-tune job store (`fx1.serve.api`).
# Default is under the server state dir, or the system temp dir. FX1 serve
# audit probes may override this.
# FX1_FT_DIR=
# [optional] Ship-gate enforcement for measurement serves (`fx1.serve.ship_gate_env`).
# Unset or any value other than 0/false keeps the gate on. 0/false allows a
# labelled measurement serve (goldenpath timing only).
# FX1_ENFORCE_SHIP_GATE=

# ── fx-1 BYOK backend (operator-owned model server) ─────────────────────
# [optional] Base URL of a BYOK OpenAI-compatible backend.
# FX1_BYOK_BASE_URL=
# [optional] API key for that backend.
# FX1_BYOK_API_KEY=
# [optional] Model name to request from that backend.
# FX1_BYOK_MODEL=
# [optional] BYOK allows public global-unicast providers by default.
# Enable this only for operator-owned loopback/RFC1918/IPv6-ULA model
# servers; metadata, link-local, shared, reserved, and documentation
# networks remain blocked.
# FX1_BYOK_ALLOW_PRIVATE_NETWORKS=1

# ── fx-1 local engine (attached/spawned OpenAI-compatible engine) ───────
# [optional] URL of a running local engine (fx1 serve can adopt it).
# FX1_LOCAL_SERVE_URL=
# [optional] Spawn template for a local engine when none is running.
# FX1_LOCAL_SERVE_CMD=
# [optional] Model name served by the local engine.
# FX1_LOCAL_MODEL=
# [optional] API key presented to the local engine.
# FX1_LOCAL_API_KEY=
# [optional] Per-request timeout for the local engine, seconds.
# FX1_LOCAL_TIMEOUT_S=
# [optional] Startup wait for a spawned local engine, seconds.
# FX1_LOCAL_START_TIMEOUT_S=

# ── fx1 serve HTTP surface (all optional; defaults are conservative) ────
# FX1_API_HOST=            # bind host (loopback unless overridden)
# FX1_API_PORT=            # bind port
# FX1_API_KEY=             # [conditional] required for non-loopback binding
# FX1_API_PUBLIC_RELEASE=1 # public policy when loopback sits behind a reverse proxy
# FX1_API_RATE_LIMIT_RPS=  # per-key request rate limit
# FX1_API_SSE_KEEPALIVE_S= # SSE keepalive interval
# FX1_API_MAX_INFLIGHT=    # concurrent in-flight request cap
# FX1_API_IDEM_MAX=        # idempotency-key store size
# FX1_API_JOB_MAX=         # background job queue cap
# FX1_API_GZIP_MIN_BYTES=  # response gzip threshold
# FX1_API_CORS_ORIGINS=    # explicit CORS allowlist (off unless set)
# FX1_API_BREAKER_THRESHOLD=  # circuit-breaker trip count
# FX1_API_BREAKER_COOLDOWN_S= # circuit-breaker cooldown, seconds
# FX1_API_RECEIPTS_DIR=    # where completion receipts are written
# FX1_API_STATE_DIR=       # server-side state root
# FX1_API_BYOK_OVERRIDE=   # per-request BYOK override toggle
# FX1_API_FILE_MAX=        # upload file-count cap
# FX1_API_FILE_BYTES=      # per-file size cap
# FX1_API_BATCH_MAX=       # batch request cap
# FX1_API_BATCH_LINES=     # batch line cap
# FX1_API_STORE_MAX=       # store payload cap
# [optional] Allow webhook/loopback delivery targets on private networks
# (default off; public global-unicast only).
# FX1_WEBHOOK_ALLOW_PRIVATE_NETWORKS=

# ── fx-1 data-source plugin credentials ─────────────────────────────────
# [optional] Plugin roots override for fx1 data sources (colon-separated).
# FX1_PLUGIN_ROOTS=
# [optional] Agent-gateway plugin credentials (read only when a plugin
# source declares them).
# KIMI_API_KEY=
# AGENT_GW_TOKEN=
# [optional] Generic plugin datasource endpoint + credential.
# DATASOURCE_BASE_URL=
# DATASOURCE_API_KEY=
# [optional] Credential for the generic vendor-HTTP adapter.
# VENDOR_HTTP_API_KEY=
# [optional] Public-data vendor adapters (BEA / FRED). Unset = that
# adapter is unavailable; nothing fails open.
# BEA_API_KEY=
# FRED_API_KEY=

# ── Research API server roots (loopback-only by default) ────────────────
# [optional] Data root (falls back to QUANT_DATA_ROOT, then <repo>/data).
# RESEARCH_API_DATA_ROOT=
# [optional] Where verified artifacts are published.
# RESEARCH_API_ARTIFACTS_DIR=
# [optional] Receipts root (immutable evidence; never rewrite).
# RESEARCH_API_RECEIPTS_DIR=
# [optional] Verifier working root.
# RESEARCH_API_VERIFIER_DIR=
# [optional] Bind host/port; non-loopback requires RESEARCH_API_KEY.
# RESEARCH_API_HOST=
# RESEARCH_API_PORT=

# ── Operator live desk (docs/LIVE_DESK.md) ──────────────────────────────
# [optional] Desk directory. Default: ~/.dipcatcher/live
# DIP_LIVE_ROOT=
# [conditional] Must be the single character 1 before a drop-folder ticket
# is written. Unset or any other value holds the order on the desk.
# Loopback rehearsal does not read this variable. Never a broker secret.
# DIP_LIVE_ARM=

# ── Audit ledger and observability ──────────────────────────────────────
# Off leaves ingest, features, model, decision, and simulated execution
# on their original code paths.
# DIPCATCHER_OBSERVE=1
# DIPCATCHER_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# DIPCATCHER_METRICS_PORT=9464
# DIPCATCHER_METRICS_HOST=127.0.0.1

# ── Thread pinning, determinism, native builds ──────────────────────────
# Pin BLAS/OpenMP threads for reproducible numeric results and to keep
# the remote fleet's jobs from thrashing (manifest schema carries these):
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# NUMEXPR_NUM_THREADS=1
# TOKENIZERS_PARALLELISM=false
# [optional] Fixed hash seed for deterministic iteration in runs/tests.
# PYTHONHASHSEED=0
# [optional] Native kernel selection for quant_fund.market_sim/native:
# auto (default) | python | rust.
# QUANT_FUND_NATIVE=auto
# [optional] C compiler for the market_sim JIT kernel (Windows fleet sets
# this to the MinGW gcc).
# LOB_CORE_CC=
# [optional] Cache root consulted by the market_sim native loader.
# XDG_CACHE_HOME=

# ── Terminal/UI passthrough (read-only convenience) ─────────────────────
# NO_COLOR=                # disable ANSI styling
# COLORFGBG=               # terminal fg;bg hint for theme detection
# FXI_ORBS=off             # disable fx1 interactive spinner orbs

# ── Test / audit-harness internals (NOT operator config) ────────────────
# Set and torn down by tests and audit probes only; documented for
# completeness of the env-var contract. Never set these in production:
# DS_AUDIT_SENTINEL=
# DS_AUDIT_KEY=
# MUT_ROOT=
# MUTATION_TARGET_MODULE=
# MUTATION_TARGET_FILE=
# FX1_TEMPORARY_AUDIT_VALUE=
# FX1_NEW_PROBE_CONFIG=
# DS_AUDIT_MISSING=
